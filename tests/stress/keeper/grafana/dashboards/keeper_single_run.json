{
    "__inputs": [
        {
            "name": "DS_CLICKHOUSE",
            "label": "ClickHouse",
            "description": "ClickHouse datasource",
            "type": "datasource",
            "pluginId": "grafana-clickhouse-datasource",
            "pluginName": "ClickHouse"
        }
    ],
    "__requires": [
        {
            "type": "grafana",
            "id": "grafana",
            "name": "Grafana",
            "version": "9.5.0"
        },
        {
            "type": "datasource",
            "id": "grafana-clickhouse-datasource",
            "name": "ClickHouse",
            "version": "3.7.0"
        }
    ],
    "title": "Keeper Single Run (metrics_ts)",
    "editable": true,
    "panels": [
        {
            "type": "table",
            "title": "Prom metrics (sum by name)",
            "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "${DS_CLICKHOUSE}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "options": {
                "showHeader": true
            },
            "targets": [
                {
                    "format": 1,
                    "query": "SELECT name, sum(value) AS v FROM keeper_stress_tests.keeper_metrics_ts WHERE run_id='${run}' AND source='prom' GROUP BY name ORDER BY v DESC LIMIT 50"
                }
            ]
        },
        {
            "type": "timeseries",
            "title": "Latency p99 (if present)",
            "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "${DS_CLICKHOUSE}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "targets": [
                {
                    "format": 1,
                    "query": "SELECT toStartOfInterval(ts, INTERVAL 10 second) AS t, quantileExact(0.99)(value) AS p99 FROM keeper_stress_tests.keeper_metrics_ts WHERE run_id='${run}' AND source='prom' AND name ILIKE '%latency%' GROUP BY t ORDER BY t"
                }
            ]
        },
        {
            "type": "table",
            "title": "mntr watchers (post)",
            "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "${DS_CLICKHOUSE}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "targets": [
                {
                    "format": 1,
                    "query": "SELECT node, avg(value) AS zk_watch_count FROM keeper_stress_tests.keeper_metrics_ts WHERE run_id='${run}' AND source='mntr' AND name='zk_watch_count' AND stage='post' GROUP BY node ORDER BY node"
                }
            ]
        },
        {
            "type": "barchart",
            "title": "Top CH metrics (post)",
            "datasource": {
                "type": "grafana-clickhouse-datasource",
                "uid": "${DS_CLICKHOUSE}"
            },
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "targets": [
                {
                    "format": 1,
                    "query": "SELECT name, avg(value) AS v FROM keeper_stress_tests.keeper_metrics_ts WHERE run_id='${run}' AND source='ch_metrics' AND stage='post' GROUP BY name ORDER BY v DESC LIMIT 20"
                }
            ]
        }
    ],
    "templating": {
        "list": [
            {
                "name": "run",
                "type": "query",
                "label": "run_id",
                "datasource": {
                    "type": "grafana-clickhouse-datasource",
                    "uid": "${DS_CLICKHOUSE}"
                },
                "query": "SELECT DISTINCT run_id FROM keeper_stress_tests.keeper_metrics_ts ORDER BY run_id DESC LIMIT 200",
                "refresh": 1
            }
        ]
    },
    "schemaVersion": 37,
    "version": 1
}